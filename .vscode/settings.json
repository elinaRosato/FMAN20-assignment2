{
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-safe",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "%DOCFILE%"
            ],
            "env": {}
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk-safe",
            "tools": ["latexmk-safe"]
        }
    ],
    "latex-workshop.latex.recipe.default": "latexmk-safe"
}
